# Base URL of the ASP.NET Core Web API (OnlineAuctionSystem.Presentation).
# Must match whichever launch profile you actually run — see
# OnlineAuctionSystem.Presentation/Properties/launchSettings.json:
#   "http"  profile -> http://localhost:5201
#   "https" profile -> https://localhost:7201
VITE_API_BASE_URL=https://localhost:7201/api
VITE_SIGNALR_HUB_URL=https://localhost:7201/hubs/notifications